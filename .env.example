# Ghibiri Home — configurazione
# Copia questo file in `.env` e compila i valori. Non committare `.env`.

# ── Rete ────────────────────────────────────────────────────────────────────
# Porta pubblicata sul server (Cloudflare Tunnel punterà a http://localhost:3080)
APP_PORT=3080
# Indirizzo pubblico (usato nelle email). Per il primo accesso in rete locale
# puoi usare http://IP-DEL-SERVER:3080, poi passare a https://mamma.gabrielepili.it
APP_URL=http://localhost:3080
# Lascia vuoto: il cookie diventa Secure automaticamente quando la richiesta
# arriva in HTTPS (Cloudflare Tunnel) o quando APP_URL inizia con https.
COOKIE_SECURE=

# ── Primo avvio ─────────────────────────────────────────────────────────────
# PIN di 4 cifre. Se lo lasci vuoto viene generato un PIN casuale e stampato
# nei log del container (`docker compose logs ghibiri-home`).
ADMIN_NAME=Gabriele
ADMIN_PIN=
ADMIN_EMAIL=

MAMMA_NAME=Mamma
MAMMA_PIN=
MAMMA_EMAIL=

# ── Email (promemoria) ──────────────────────────────────────────────────────
# Esempio Gmail: smtp.gmail.com, 587, STARTTLS, password per le app.
# Se SMTP_HOST è vuoto i promemoria restano in coda e non vengono inviati.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ghibiri Home <no-reply@ghibiri.it>"
MAIL_REPLY_TO=

# ── Servizio ────────────────────────────────────────────────────────────────
TZ=Europe/Rome
MAX_UPLOAD_MB=15
MAX_ATTACHMENTS=12
SESSION_DAYS=30
# 1 = dietro un proxy (Cloudflare Tunnel). Lascia 1.
TRUST_PROXY=1
# true per caricare contenuti di esempio al primo avvio (solo per prove)
SEED_DEMO=false

# ── Cloudflare Tunnel (facoltativo, per docker-compose.tunnel.yml) ──────────
TUNNEL_TOKEN=
