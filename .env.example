# Ghibiri Home — configurazione
# Copia questo file in `.env` e compila i valori. Non committare `.env`.

# ── Rete ────────────────────────────────────────────────────────────────────
# Porta pubblicata sul server (Cloudflare Tunnel punterà a http://localhost:3080)
APP_PORT=3080
# Indirizzo pubblico (usato nelle email). Per il primo accesso in rete locale
# puoi usare http://IP-DEL-SERVER:3080, poi passare a https://mamma.gabrielepili.it
APP_URL=http://localhost:3080
# Lascia vuoto: il cookie diventa Secure automaticamente quando la richiesta
# arriva in HTTPS (Cloudflare Tunnel) o quando APP_URL inizia con https.
COOKIE_SECURE=

# ── Primo avvio ─────────────────────────────────────────────────────────────
# PIN di 4 cifre. Se lo lasci vuoto viene generato un PIN casuale e stampato
# nei log del container (`docker compose logs ghibiri-home`).
ADMIN_NAME=Gabriele
ADMIN_PIN=
ADMIN_EMAIL=

MAMMA_NAME=Mamma
MAMMA_PIN=
MAMMA_EMAIL=

# ── Email (promemoria) ──────────────────────────────────────────────────────
# Esempio Gmail: smtp.gmail.com, 587, STARTTLS, password per le app.
# Se SMTP_HOST è vuoto i promemoria restano in coda e non vengono inviati.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ghibiri Home <no-reply@ghibiri.it>"
MAIL_REPLY_TO=

# ── Ricette con AI (facoltativo) ───────────────────────────────────────────
# Per il MODELLO LOCALE non serve compilare questi campi: usa
#   docker compose -f docker-compose.yml -f docker-compose.local-ai.yml up -d --build
# Qui sotto trovi invece la configurazione per un provider esterno.
# Provider compatibile OpenAI. Se AI_BASE_URL è vuoto il pulsante "Genera con AI"
# resta nascosto. La chiave resta nel .env e non viene mai inviata al browser.
# Esempi:
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=google/gemini-2.0-flash-001
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   Ollama LAN  AI_BASE_URL=http://192.168.1.10:11434/v1     AI_MODEL=qwen2.5:1.5b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=1600
# object = JSON mode standard; schema = schema rigido (llama.cpp locale); off = nessuno
AI_JSON_MODE=object
AI_TEMPERATURE=0.85

# Modello locale: usato solo da docker-compose.local-ai.yml.
# Default: Qwen2.5 0.5B Instruct Q4_K_M (Apache 2.0, ~400 MB).
LOCAL_AI_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf
# Thread CPU per il modello locale. 2 è prudente; 4 se il server ha core liberi.
LOCAL_AI_THREADS=2

# ── Servizio ────────────────────────────────────────────────────────────────
TZ=Europe/Rome
MAX_UPLOAD_MB=15
MAX_ATTACHMENTS=12
SESSION_DAYS=30
# 1 = dietro un proxy (Cloudflare Tunnel). Lascia 1.
TRUST_PROXY=1
# true per caricare contenuti di esempio al primo avvio (solo per prove)
SEED_DEMO=false

# ── Cloudflare Tunnel (facoltativo, per docker-compose.tunnel.yml) ──────────
TUNNEL_TOKEN=
